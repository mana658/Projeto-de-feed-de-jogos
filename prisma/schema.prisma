generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Game {
  id        String   @id @default(uuid())
  title     String
  authorId  String
  sourceUrl String
  code      String
  createdAt DateTime @default(now())
}